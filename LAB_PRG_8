b. Indexed File Allocation

#include <stdio.h>

int main()
{
    int indexBlock, n, i;
    int blocks[20];

    printf("Enter index block: ");
    scanf("%d", &indexBlock);

    printf("Enter number of blocks occupied by file: ");
    scanf("%d", &n);

    printf("Enter file blocks:\n");

    for(i = 0; i < n; i++)
        scanf("%d", &blocks[i]);

    printf("\nIndex Block: %d\n", indexBlock);

    printf("Allocated File Blocks:\n");

    for(i = 0; i < n; i++)
        printf("%d ", blocks[i]);

    printf("\n");

    return 0;
}

OUTPUT:

Enter index block: 4

Enter number of blocks occupied by file: 5

Enter file blocks:
10
15
22
30
45

Index Block: 4

Allocated File Blocks:
10 15 22 30 45

