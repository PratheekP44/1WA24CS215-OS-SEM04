c. Hierarchical Directory

#include <stdio.h>

int main()
{
    int mainDir, subDir, files;
    int i, j;

    printf("Enter number of main directories: ");
    scanf("%d", &mainDir);

    for(i = 0; i < mainDir; i++)
    {
        printf("\nEnter number of subdirectories in Directory %d: ", i + 1);
        scanf("%d", &subDir);

        for(j = 0; j < subDir; j++)
        {
            printf("Enter number of files in Subdirectory %d: ", j + 1);
            scanf("%d", &files);
        }
    }

    printf("\nHierarchical Directory Structure Created Successfully.\n");

    return 0;
}

OUTPUT:

Enter number of main directories: 2

Enter number of subdirectories in Directory 1: 2
Enter number of files in Subdirectory 1: 3
Enter number of files in Subdirectory 2: 2

Enter number of subdirectories in Directory 2: 1
Enter number of files in Subdirectory 1: 4

Hierarchical Directory Structure Created Successfully.

