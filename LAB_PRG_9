Program 9
a. Single Level Directory

#include <stdio.h>
#include <string.h>

int main()
{
    int n, i;
    char files[20][30];

    printf("Enter number of files: ");
    scanf("%d", &n);

    printf("Enter file names:\n");
    for(i = 0; i < n; i++)
        scanf("%s", files[i]);

    printf("\nFiles in Single Level Directory:\n");

    for(i = 0; i < n; i++)
        printf("%s\n", files[i]);

    return 0;
}

OUTPUT:

Enter number of files: 5

Enter file names:
file1.txt
file2.txt
file3.txt
file4.txt
file5.txt

Files in Single Level Directory:
file1.txt
file2.txt
file3.txt
file4.txt
file5.txt

