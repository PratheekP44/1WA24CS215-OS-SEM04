b. SCAN Disk Scheduling

#include <stdio.h>
#include <stdlib.h>

int main()
{
    int req[20], n, head, diskSize;
    int i, j, temp, total = 0;

    printf("Enter number of requests: ");
    scanf("%d", &n);

    printf("Enter requests: ");
    for(i = 0; i < n; i++)
        scanf("%d", &req[i]);

    printf("Enter initial head position: ");
    scanf("%d", &head);

    printf("Enter disk size: ");
    scanf("%d", &diskSize);

    for(i = 0; i < n - 1; i++)
    {
        for(j = i + 1; j < n; j++)
        {
            if(req[i] > req[j])
            {
                temp = req[i];
                req[i] = req[j];
                req[j] = temp;
            }
        }
    }

    int pos;
    for(i = 0; i < n; i++)
    {
        if(req[i] > head)
        {
            pos = i;
            break;
        }
    }

    for(i = pos; i < n; i++)
    {
        total += abs(req[i] - head);
        head = req[i];
    }

    total += abs((diskSize - 1) - head);
    head = diskSize - 1;

    for(i = pos - 1; i >= 0; i--)
    {
        total += abs(req[i] - head);
        head = req[i];
    }

    printf("\nTotal Seek Time = %d\n", total);

    return 0;
}

