a. FCFS Disk Scheduling

#include <stdio.h>
#include <stdlib.h>

int main()
{
    int req[20], n, head, i;
    int totalSeek = 0;

    printf("Enter number of requests: ");
    scanf("%d", &n);

    printf("Enter request sequence: ");
    for(i = 0; i < n; i++)
        scanf("%d", &req[i]);

    printf("Enter initial head position: ");
    scanf("%d", &head);

    for(i = 0; i < n; i++)
    {
        totalSeek += abs(req[i] - head);
        head = req[i];
    }

    printf("\nTotal Seek Time = %d\n", totalSeek);

    return 0;
}

