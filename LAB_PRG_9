b. Two Level Directory

#include <stdio.h>

int main()
{
    int users, files, i, j;

    printf("Enter number of users: ");
    scanf("%d", &users);

    for(i = 0; i < users; i++)
    {
        printf("\nEnter number of files for User %d: ", i + 1);
        scanf("%d", &files);

        printf("Files of User %d:\n", i + 1);

        for(j = 0; j < files; j++)
        {
            char fname[30];
            scanf("%s", fname);
        }
    }

    printf("\nTwo Level Directory Created Successfully.\n");

    return 0;
}

OUTPUT:

Enter number of users: 2

Enter number of files for User 1: 3
Files of User 1:
fileA.txt
fileB.txt
fileC.txt

Enter number of files for User 2: 2
Files of User 2:
fileX.txt
fileY.txt

Two Level Directory Created Successfully.

