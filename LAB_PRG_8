Program 8
a. Sequential File Allocation

#include <stdio.h>

int main()
{
    int startBlock, length, i;

    printf("Enter starting block: ");
    scanf("%d", &startBlock);

    printf("Enter length of file (number of blocks): ");
    scanf("%d", &length);

    printf("\nAllocated Blocks are:\n");

    for(i = 0; i < length; i++)
    {
        printf("%d ", startBlock + i);
    }

    printf("\n");

    return 0;
}

OUTPUT:

Enter starting block: 10

Enter length of file (number of blocks): 5

Allocated Blocks are:
10 11 12 13 14

