c. Linked File Allocation

#include <stdio.h>

int main()
{
    int n, i;
    int blocks[20];

    printf("Enter number of blocks in file: ");
    scanf("%d", &n);

    printf("Enter block numbers:\n");

    for(i = 0; i < n; i++)
        scanf("%d", &blocks[i]);

    printf("\nLinked Allocation Sequence:\n");

    for(i = 0; i < n; i++)
    {
        printf("%d", blocks[i]);

        if(i != n - 1)
            printf(" -> ");
    }

    printf(" -> NULL\n");

    return 0;
}

OUTPUT:

Enter number of blocks in file: 5

Enter block numbers:
7
19
25
33
40

Linked Allocation Sequence:
7 -> 19 -> 25 -> 33 -> 40 -> NULL

